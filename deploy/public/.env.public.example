# Public domain. Example: stock.example.com
PUBLIC_DOMAIN=

# Email used by Caddy/Let's Encrypt for HTTPS certificate notices.
ACME_EMAIL=

# Change both passwords before first deploy.
LAOMA_ADMIN_USER=laoma
LAOMA_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# Optional data / AI providers.
TUSHARE_TOKEN=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Runtime flags. Keep these values for public HTTPS deployment.
INTERNAL_DEPLOYMENT=1
COOKIE_SECURE=1
MARKET_DATA_PROVIDER=eastmoney
